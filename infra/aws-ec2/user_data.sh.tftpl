#!/usr/bin/env bash
set -euxo pipefail

export DEBIAN_FRONTEND=noninteractive

apt-get update
apt-get install -y ca-certificates curl git nginx

install -m 0755 -d /etc/apt/keyrings
curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
chmod a+r /etc/apt/keyrings/docker.asc
echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo "$VERSION_CODENAME") stable" > /etc/apt/sources.list.d/docker.list
apt-get update
apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin

systemctl enable --now docker

if [ ! -f /swapfile ]; then
  fallocate -l 2G /swapfile
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  echo "/swapfile none swap sw 0 0" >> /etc/fstab
else
  swapon /swapfile || true
fi

cat >/etc/crapi-lab.env <<'ENV'
CRAPI_REPO_URL='${crapi_repo_url}'
CRAPI_REPO_REF='${crapi_repo_ref}'
CRAPI_VERSION='${crapi_version}'
ENV

cat >/usr/local/bin/crapi-sync-repo <<'SCRIPT'
#!/usr/bin/env bash
set -euxo pipefail
source /etc/crapi-lab.env

if [ ! -d /opt/crapi/.git ]; then
  rm -rf /opt/crapi
  git clone --depth 1 --branch "$CRAPI_REPO_REF" "$CRAPI_REPO_URL" /opt/crapi
else
  git -C /opt/crapi remote set-url origin "$CRAPI_REPO_URL"
  git -C /opt/crapi fetch --depth 1 origin "$CRAPI_REPO_REF"
  git -C /opt/crapi reset --hard FETCH_HEAD
  git -C /opt/crapi clean -fdx
fi
SCRIPT
chmod +x /usr/local/bin/crapi-sync-repo

/usr/local/bin/crapi-sync-repo

cat >/opt/crapi/deploy/docker/.env <<ENV
VERSION=${crapi_version}
LISTEN_IP=127.0.0.1
TLS_ENABLED=false
ENABLE_SHELL_INJECTION=false
ENABLE_LOG4J=false
CHATBOT_LIFE=0
ENV

cat >/opt/crapi/deploy/docker/docker-compose.local-web.yml <<'COMPOSE'
services:
  crapi-web:
    build:
      context: ../../services/web
COMPOSE

cat >/usr/local/bin/crapi-reset <<'SCRIPT'
#!/usr/bin/env bash
set -euxo pipefail
/usr/local/bin/crapi-sync-repo
cd /opt/crapi/deploy/docker
source /etc/crapi-lab.env
cat >.env <<ENV
VERSION=$CRAPI_VERSION
LISTEN_IP=127.0.0.1
TLS_ENABLED=false
ENABLE_SHELL_INJECTION=false
ENABLE_LOG4J=false
CHATBOT_LIFE=0
ENV
cat >docker-compose.local-web.yml <<'COMPOSE'
services:
  crapi-web:
    build:
      context: ../../services/web
COMPOSE
docker compose -f docker-compose.yml -f docker-compose.local-web.yml --compatibility down -v --remove-orphans || true
docker compose -f docker-compose.yml -f docker-compose.local-web.yml --compatibility pull --ignore-buildable
docker compose -f docker-compose.yml -f docker-compose.local-web.yml --compatibility build crapi-web
docker compose -f docker-compose.yml -f docker-compose.local-web.yml --compatibility up -d
docker image prune -af || true
SCRIPT
chmod +x /usr/local/bin/crapi-reset

cat >/etc/systemd/system/crapi-reset.service <<'UNIT'
[Unit]
Description=Reset OWASP crAPI lab
After=docker.service network-online.target
Wants=docker.service network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/crapi-reset
UNIT

cat >/etc/systemd/system/crapi-reset.timer <<UNIT
[Unit]
Description=Reset OWASP crAPI lab every ${reset_interval_minutes} minutes

[Timer]
OnBootSec=5min
OnUnitActiveSec=${reset_interval_minutes}min
AccuracySec=1min
Persistent=true
Unit=crapi-reset.service

[Install]
WantedBy=timers.target
UNIT

cat >/etc/nginx/sites-available/default <<'NGINX'
server {
    listen 80 default_server;
    server_name _;

    client_max_body_size 20m;

    location / {
        proxy_pass http://127.0.0.1:8888;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
NGINX
nginx -t
systemctl enable --now nginx
systemctl restart nginx

systemctl daemon-reload
systemctl enable --now crapi-reset.timer
systemctl start crapi-reset.service
